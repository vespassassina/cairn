{
  "name": "@vespassassina/cairncli",
  "version": "0.1.6",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespassassina/cairn.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "description": "Command-line client for Cairn: a wiki and tables your agents can write to, with every change reviewable.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "cairn": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cairn/api": "workspace:*",
    "@cairn/core": "workspace:*"
  }
}
