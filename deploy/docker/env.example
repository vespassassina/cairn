# Copy to .env in this folder and fill in. .env is ignored by git; keep it
# private (chmod 600 .env). See docs/DEPLOY-DOCKER.md.

# The https address people and Claude reach Cairn at, through your reverse
# proxy or tunnel.
CAIRN_PUBLIC_URL=https://cairn.example.com

# Sign-in: github, or oidc with CAIRN_OIDC_ISSUER for Entra ID, Google and
# other OpenID Connect providers.
CAIRN_AUTH_PROVIDER=github
# CAIRN_OIDC_ISSUER=https://accounts.google.com
CAIRN_OAUTH_CLIENT_ID=
CAIRN_OAUTH_CLIENT_SECRET=

# Who may sign in, comma-separated: github:login, email:you@example.com, oidc:<subject>
CAIRN_ALLOWED_USERS=

# Signing secret, at least 32 characters: the output of `openssl rand -hex 32`.
# Keep it the same across restarts, or everyone is signed out.
CAIRN_AUTH_SECRET=

# Optional: a copy of the database off this machine, streamed by Litestream,
# for example to S3 or an S3-compatible store. Leave unset to keep only ./data.
# CAIRN_REPLICA_URL=s3://bucket/cairn.sqlite
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
