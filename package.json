{
  "name": "cairn",
  "version": "0.1.8",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespassassina/cairn.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sequential build",
    "test": "vitest run",
    "typecheck": "pnpm -r --sequential typecheck",
    "dev": "pnpm --filter @cairn/api dev",
    "import:markdown": "pnpm --filter @cairn/api import:markdown",
    "reindex": "pnpm --filter @cairn/api reindex",
    "eval": "pnpm --filter @cairn/api eval",
    "cairn": "tsx packages/cli/src/bin.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "context-cost": "pnpm --filter @cairn/api context-cost",
    "sync:artifactkit": "node scripts/sync-artifactkit.mjs",
    "build:server": "node scripts/build-server.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
